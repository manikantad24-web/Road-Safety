# Copy to backend/.env  (PowerShell: Copy-Item .env.example backend\.env)
# Never commit the real .env. Nothing here is read by the frontend.

# --- Server -----------------------------------------------------------
DATABASE_URL=sqlite:///./data/roadguardian.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Admin (LOCAL DEMO ONLY - a shared token, NOT real authentication) ---
# Required to change report status. Choose a long random value. If empty, status updates are disabled.
ADMIN_TOKEN=change-me-to-a-long-random-string

# --- Community verification --------------------------------------------
VERIFY_THRESHOLD=3

# --- AI road-damage detection ------------------------------------------
# Path to Ultralytics YOLO weights trained on road damage. If missing, the app shows an AI-unavailable state.
YOLO_WEIGHTS_PATH=./models_weights/road_damage.pt
YOLO_CONF=0.25
YOLO_IOU=0.45
YOLO_IMGSZ=640
# Optional JSON mapping model class names -> pothole|crack|surface_damage|debris|waterlogging|missing_signage|other
# DETECTION_CLASS_MAP={"D40":"pothole","D00":"crack"}

# --- Routing -----------------------------------------------------------
ROUTING_PROVIDER=osrm
# The public OSRM demo server is for light demo use only; self-host OSRM or use a commercial provider.
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_S=12
ROUTING_MAX_ALTERNATIVES=3

# --- Risk scoring (defaults documented in README) ----------------------
RISK_BUFFER_M=60
RISK_WEIGHT_LOW=1.0
RISK_WEIGHT_MEDIUM=2.5
RISK_WEIGHT_HIGH=5.0
RISK_RECENCY_HALF_LIFE_DAYS=30
RISK_SATURATION_SCALE=10

# --- Demo data ---------------------------------------------------------
SEED_CENTER_LAT=18.5204
SEED_CENTER_LNG=73.8567

# Route safety: safer alternatives beyond this detour are replaced by the shortest route only.
ROUTE_DETOUR_THRESHOLD_PERCENT=20
